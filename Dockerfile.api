# syntax=docker/dockerfile:1
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY src/EnterpriseRag/EnterpriseRag.csproj src/EnterpriseRag/
COPY src/EnterpriseRag.Api/EnterpriseRag.Api.csproj src/EnterpriseRag.Api/
RUN dotnet restore src/EnterpriseRag.Api/EnterpriseRag.Api.csproj
COPY src/EnterpriseRag/ src/EnterpriseRag/
COPY src/EnterpriseRag.Api/ src/EnterpriseRag.Api/
RUN dotnet publish src/EnterpriseRag.Api/EnterpriseRag.Api.csproj -c Release --no-restore -o /app/publish /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final
WORKDIR /app
RUN groupadd --system rag && useradd --system --gid rag rag
COPY --from=build /app/publish/ ./
USER rag
ENV ASPNETCORE_URLS=http://+:8080
EXPOSE 8080
ENTRYPOINT ["dotnet", "EnterpriseRag.Api.dll"]
